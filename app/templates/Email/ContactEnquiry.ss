<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New enquiry</title>
</head>
<body style="margin:0; padding:0; background-color:#f2f0f5; font-family:Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f2f0f5; padding:32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background-color:#ffffff; border-radius:8px; overflow:hidden;">
                    <tr>
                        <td style="background-color:#1c0f33; padding:24px 32px;">
                            <span style="display:block; color:#f7933f; font-size:12px; font-weight:bold; letter-spacing:.5px; text-transform:uppercase; margin-bottom:4px;">Tairāwhiti Investments</span>
                            <span style="display:block; color:#ffffff; font-size:20px; font-weight:bold;">New website enquiry</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:32px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                                <tr>
                                    <td style="padding:0 0 12px; border-bottom:1px solid #eeeeee; color:#1c0f33; font-size:14px;">
                                        <strong>Name</strong><br>
                                        $FirstName $LastName
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:12px 0; border-bottom:1px solid #eeeeee; color:#1c0f33; font-size:14px;">
                                        <strong>Email</strong><br>
                                        <a href="mailto:$Email" style="color:#027ea6; text-decoration:none;">$Email</a>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:12px 0 0; color:#1c0f33; font-size:14px;">
                                        <strong>Enquiry type</strong><br>
                                        $EnquiryType
                                    </td>
                                </tr>
                            </table>

                            <span style="display:block; color:#1c0f33; font-size:12px; font-weight:bold; letter-spacing:.5px; text-transform:uppercase; margin-bottom:8px;">Message</span>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f8f7fa; border-left:3px solid #f7933f; border-radius:4px;">
                                <tr>
                                    <td style="padding:16px; color:#1c0f33; font-size:14px; line-height:1.6;">
                                        $Message.RAW
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:16px 32px; background-color:#f8f7fa; color:#88839a; font-size:12px;">
                            Sent from the contact form on tairawhitiinvestments.nz
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
